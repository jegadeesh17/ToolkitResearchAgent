# Copy to .env and fill in your own keys. Never commit .env.
#   cp .env.example .env

# --- LLM Backend Configuration ---
# Default is openrouter (requires OPENROUTER_API_KEY).
# Set LLM_BACKEND=agy to use local Antigravity CLI ($0 spend):
LLM_BACKEND=agy
PASS1_MODEL=gemini-3.8-flash-medium
VERIFY_MODEL=gpt-oss-120b-medium
JUDGE_MODEL=claude-sonnet-4-6

# --- Secrets (bring your own) ---
# Composio: dedicated project API key (search/fetch tools)
COMPOSIO_API_KEY=REPLACE_ME
# Optional Tavily API key for direct developer doc search fallback:
TAVILY_API_KEY=

# OpenRouter (only needed if LLM_BACKEND=openrouter):
# OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# --- Guardrails ---
# The agent refuses to start a call once logged spend reaches this cap (exit code 4)
BUDGET_CAP_USD=4.00
